PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/autoroute-ai

# Primary Gemini key/model
GEMINI_API_KEY_PRIMARY=your_primary_gemini_api_key
GEMINI_MODEL_PRIMARY=gemini-3.8-flash

# Fallback Gemini key/model (used when primary hits 429 / quota / timeout)
GEMINI_API_KEY_FALLBACK=your_fallback_gemini_api_key
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite

CORS_ORIGIN=http://localhost:5173

# Single-access-code login (no username). Set both to your own values.
APP_ACCESS_CODE=change_me
AUTH_TOKEN_SECRET=a_long_random_string_used_to_sign_login_tokens
